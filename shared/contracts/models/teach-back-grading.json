{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sikhyasetu.local/contracts/models/teach-back-grading.json",
  "title": "TeachBackGrade",
  "description": "Deterministic rubric grading of a learner's own explanation. Low-confidence responses are flagged, never guessed.",
  "type": "object",
  "additionalProperties": true,
  "required": ["profile_id", "concept_id", "transcript", "score", "rubric", "needs_review"],
  "properties": {
    "profile_id": { "type": "string" },
    "concept_id": { "type": "string" },
    "transcript": { "type": "string" },
    "score": { "type": "number", "minimum": 0, "maximum": 1 },
    "rubric": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "met", "note"],
        "properties": {
          "id": {
            "type": "string",
            "enum": ["mentions_concept", "explains_mechanism", "uses_local_example", "avoids_misconception"]
          },
          "met": { "type": "boolean" },
          "note": { "type": "string" }
        }
      }
    },
    "misconception_id": { "type": ["string", "null"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "needs_review": {
      "type": "boolean",
      "description": "True when the answer is too short/ambiguous to grade; routed to a teacher."
    },
    "feedback_or": { "type": "string" },
    "next_review_at": { "type": ["string", "null"], "format": "date-time" },
    "fingerprint": { "type": ["object", "null"] }
  }
}
