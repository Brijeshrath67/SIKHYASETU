{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sikhyasetu.local/contracts/models/mastery-state.json",
  "title": "MasteryState",
  "description": "Per-learner, per-concept mastery and spaced-revision schedule.",
  "type": "object",
  "additionalProperties": true,
  "required": ["profile_id", "concept_id", "mastery", "status"],
  "properties": {
    "profile_id": { "type": "string" },
    "concept_id": { "type": "string" },
    "mastery": { "type": "number", "minimum": 0, "maximum": 1 },
    "status": {
      "type": "string",
      "enum": ["unresolved", "repairing", "review", "mastered", "needs_review"]
    },
    "misconception_id": { "type": ["string", "null"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "next_review_at": { "type": ["string", "null"], "format": "date-time" },
    "updated_at": { "type": ["string", "null"], "format": "date-time" }
  }
}
